{
  "cvat": {
    "url": "http://localhost:8080",
    "token": "your_cvat_token_here",
    "default_project_name": "Floorplan Segmentation",
    "labels": [
      {
        "name": "indoor",
        "color": "#00ff00",
        "attributes": []
      },
      {
        "name": "outdoor", 
        "color": "#0000ff",
        "attributes": []
      },
      {
        "name": "architectural_elements",
        "color": "#ff0000",
        "attributes": []
      }
    ]
  },
  "processing": {
    "dpi": 300,
    "uploads_dir": "server/uploads",
    "max_file_size_mb": 50,
    "supported_formats": [".pdf"],
    "cleanup_days": 30
  },
  "image_processing": {
    "edge_detection": {
      "lower_threshold": 50,
      "upper_threshold": 150,
      "aperture_size": 3
    },
    "contour_filtering": {
      "min_area": 1000,
      "approximation_epsilon": 0.02
    }
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "cors_origins": ["*"],
    "max_upload_size": 52428800
  }
}